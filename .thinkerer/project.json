{
  "schemaVersion": 1,
  "name": "Thinkerer",
  "components": [
    "website"
  ],
  "target": "electron",
  "website": {
    "devCommand": "npm run dev:web",
    "previewUrl": "http://localhost:5174"
  },
  "agent": {
    "provider": "auto",
    "enabledMcpServers": [
      "playwright",
      "health"
    ]
  },
  "marketing": {
    "enabled": true
  },
  "protocol": {
    "checkCommand": "npm run typecheck && npm test",
    "maxReviewRounds": 2,
    "review": {
      "model": "",
      "effort": ""
    }
  }
}
