{
  "schemaVersion": 1,
  "name": "Thinkerer",
  "components": [
    "website"
  ],
  "target": "electron",
  "website": {
    "devCommand": "npm run dev:web",
    "previewUrl": "http://localhost:{port1:5174}"
  },
  "agent": {
    "provider": "auto",
    "enabledMcpServers": [
      "playwright",
      "health"
    ]
  },
  "marketing": {
    "enabled": true
  },
  "worktrees": {
    "setupCommand": "npm ci",
    "teardownCommand": "",
    "ports": 1
  }
}
